# URL publica do projeto (Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Chave secreta para o script local (Settings > API Keys).
# Prefira uma chave moderna sb_secret_*. A service_role legada tambem funciona,
# mas nunca deve ser enviada ao navegador nem versionada no GitHub.
SUPABASE_SECRET_KEY=sb_secret_your_secret_key
